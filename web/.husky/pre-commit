# Только если в коммите есть файлы фронта — коммиты api/ хук не трогает
git diff --cached --name-only | grep -q '^web/' || exit 0
# --no-stash: при ошибке линта коммит просто не проходит; lint-staged не делает
# резервный stash и не сбрасывает рабочую копию (это ломало параллельную работу)
cd web && npx lint-staged --no-stash
