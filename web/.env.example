# Адрес FastAPI без /api/v1 (api/: docker compose up). Нужен и при сборке:
# /api/v1/* проксируется через rewrites, чтобы cookie сессии была на домене
# сайта. В проде API_PUBLIC_URL бэкенда = адрес сайта, тогда и Google-callback
# идёт через тот же домен.
API_URL=http://localhost:8000

# Форма входа без Google и Telegram (/auth/dev-login бэкенда, только вне прода)
NEXT_PUBLIC_DEV_LOGIN=1

# ID бота для входа через Telegram (из @BotFather; домен — командой /setdomain).
# Без него кнопка Telegram неактивна.
NEXT_PUBLIC_TELEGRAM_BOT_ID=
