# Настройки продакшн-стека. На сервере лежит в /opt/pawrescue/deploy/.env
# Первый deploy.sh создаёт этот файл сам и заполняет секреты случайными значениями.

# Домен сайта. S3 будет доступен на s3.<домен> — обе A-записи на IP сервера.
# Без своего домена: <ip-через-дефисы>.sslip.io
SITE_DOMAIN=93-170-73-79.sslip.io

# prod — вход только через Google/Telegram.
# dev  — демо-режим: включён /auth/dev-login (вход под любой ролью без пароля).
APP_ENV=prod
# 1 — показать на фронте форму dev-входа (вместе с APP_ENV=dev). Вшивается при сборке.
NEXT_PUBLIC_DEV_LOGIN=

# Секреты (генерируются: openssl rand -hex 32)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Вход через Google: redirect URI https://<домен>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Вход через Telegram: в @BotFather /setdomain -> <домен>
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_ID=

SENTRY_DSN=
