(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip

	# Браузер ходит в API напрямую: вход, опрос чата, лайки, избранное и WebSocket
	# /api/v1/ws (его Next.js проксировать не умеет). Caddy сам пробрасывает Upgrade.
	# Доступ к данным защищают сессия, проверка Origin и лимиты в самом API.
	handle /api/v1/* {
		reverse_proxy api:8000
	}

	# Swagger и схема снаружи недоступны — только через SSH-туннель
	@private_api path /api /api/* /docs /docs/* /redoc /openapi.json
	handle @private_api {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

# Presigned URL подписаны под этот хост — Caddy передаёт Host без изменений
s3.{$SITE_DOMAIN} {
	import security_headers
	request_body {
		max_size 25MB
	}
	reverse_proxy s3:8333
}
