(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip

	# API наружу не открыт: Next.js ходит в него по внутренней сети (http://api:8000).
	# Браузеру напрямую нужны только эндпоинты входа через Google и Telegram.
	# Новый эндпоинт, который вызывается из браузера, добавляйте сюда явно.
	@public_api path /api/v1/auth/google/login /api/v1/auth/google/callback /api/v1/auth/telegram
	handle @public_api {
		reverse_proxy api:8000
	}

	# Остальной API, Swagger и схема снаружи недоступны
	@private_api path /api /api/* /docs /docs/* /redoc /openapi.json
	handle @private_api {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

# Presigned URL подписаны под этот хост — Caddy передаёт Host без изменений
s3.{$SITE_DOMAIN} {
	import security_headers
	request_body {
		max_size 25MB
	}
	reverse_proxy s3:8333
}
