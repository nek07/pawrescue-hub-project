(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip

	# FastAPI напрямую, минуя Next.js: так работает WebSocket /api/v1/ws
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

# Presigned URL подписаны под этот хост — Caddy передаёт Host без изменений
s3.{$SITE_DOMAIN} {
	import security_headers
	request_body {
		max_size 25MB
	}
	reverse_proxy s3:8333
}
