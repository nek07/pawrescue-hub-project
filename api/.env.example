# Скопируйте в .env для запуска API вне Docker (uv run fastapi dev src/app/main.py)
ENV=dev
DATABASE_URL=postgresql+asyncpg://paw:paw@localhost:5433/paw
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
SQL_ECHO=false

# Вход через Google и Telegram (для dev — отдельный OAuth-клиент и тестовый бот)
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
SESSION_SECRET=dev-only-secret-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# S3 (локально — SeaweedFS из docker-compose). PUBLIC_URL — адрес, видимый браузеру.
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_URL=http://localhost:8333
S3_ACCESS_KEY=paw
S3_SECRET_KEY=pawpawpaw
# В проде — CDN перед бакетом pet-photos
PHOTOS_PUBLIC_URL=

LOG_JSON=true
SENTRY_DSN=
